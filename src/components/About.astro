---
import { Image } from "astro:assets";
import aboutStudio from "../assets/about-studio.jpg";
import logoMark from "../assets/logo-mark.png";

const attributes = ["Sleek", "Sophisticated", "Confident"];
---

<section class="about shell" id="about">
  <div class="about__copy" data-reveal-group>
    <p class="eyebrow about__eyebrow" data-reveal>About Orion</p>
    <h2 class="about__title" data-reveal>A guiding force for brands and creators</h2>
    <p class="about__lead" data-reveal>Great campaigns start with the right partnerships.</p>
    <p class="about__body" data-reveal>
      Orion Creators helps brands navigate the creator landscape by connecting them with creators who
      align with their goals, and building campaigns that deliver. From creator sourcing to campaign
      execution, we handle every step from start to finish.
    </p>
    <ul class="about__attributes" data-reveal>
      {attributes.map((attribute) => <li class="about__pill">{attribute}</li>)}
    </ul>
  </div>

  <figure class="about__figure" data-reveal="soft">
    <Image
      class="about__photo"
      src={aboutStudio}
      alt="Orion team on a studio shoot"
      widths={[480, 720, 1040]}
      sizes="(max-width: 900px) 92vw, 500px"
    />
    <div class="about__scrim" aria-hidden="true"></div>
    <Image class="about__watermark" src={logoMark} alt="" width={80} densities={[1, 2]} />
  </figure>
</section>

<style>
  .about {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
    padding-block: 100px;
  }

  .about__eyebrow {
    margin-bottom: 22px;
  }

  .about__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--font-size-h2-lead);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: 20px;
  }

  .about__lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-bright);
    margin-bottom: 24px;
    text-wrap: pretty;
  }

  .about__body {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-text-body);
    margin-bottom: 34px;
    text-wrap: pretty;
  }

  .about__attributes {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__pill {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-offwhite);
    border: var(--border-pill);
    border-radius: var(--radius-pill);
    padding: 9px 20px;
  }

  .about__figure {
    position: relative;
    aspect-ratio: 4 / 5;
    margin: 0;
    border: var(--border-default);
    border-radius: var(--radius-image);
    overflow: hidden;
    background: var(--color-surface-frame);
  }

  .about__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The photo drifts slowly inside its frame as the section passes through
     the viewport. Browsers without scroll-driven animations just hold still. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .about__figure {
        view-timeline-name: --about-figure;
      }

      .about__photo {
        animation: orionPhotoDrift linear both;
        animation-timeline: --about-figure;
        animation-range: entry 0% exit 100%;
      }
    }
  }

  .about__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 7, 11, 0.05) 40%, rgba(8, 7, 11, 0.55));
  }

  .about__watermark {
    position: absolute;
    bottom: 40px;
    left: 40px;
    width: 80px;
    height: auto;
    opacity: 0.9;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-block: 72px;
    }

    .about__watermark {
      bottom: 24px;
      left: 24px;
      width: 60px;
    }
  }
</style>
