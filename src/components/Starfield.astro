---
/**
 * Ambient parallax starfield.
 *
 * The stars are generated at build time and their per-star values are emitted
 * as real CSS rules rather than style attributes. Pointer parallax is applied
 * by writing `--par-x` / `--par-y` into a constructed stylesheet, so no inline
 * styles are ever written to the DOM.
 */
interface Props {
  count?: number;
  parallax?: boolean;
  class?: string;
}

const { count = 110, parallax = true, class: className } = Astro.props;

/** Unique per instance so several starfields can share one page. */
const fieldId = `starfield-${Math.random().toString(36).slice(2, 9)}`;

type Tier = "far" | "mid" | "mid-warm" | "near";

const stars = Array.from({ length: count }, () => {
  const depth = Math.random();
  const tier: Tier =
    depth < 0.55 ? "far" : depth < 0.82 ? "mid" : depth < 0.85 ? "mid-warm" : "near";

  return {
    tier,
    depth: depth.toFixed(3),
    left: (Math.random() * 100).toFixed(3),
    top: (Math.random() * 100).toFixed(3),
    opacity: (0.25 + depth * 0.55).toFixed(3),
    duration: (3 + Math.random() * 4).toFixed(2),
    delay: (Math.random() * 4).toFixed(2),
  };
});

const starRules = stars
  .map(
    (star, index) =>
      `#${fieldId} .starfield__star:nth-child(${index + 1}){` +
      `--depth:${star.depth};` +
      `left:${star.left}%;` +
      `top:${star.top}%;` +
      `opacity:${star.opacity};` +
      `animation-duration:${star.duration}s;` +
      `animation-delay:${star.delay}s}`,
  )
  .join("");
---

<div
  class:list={["starfield", className]}
  id={fieldId}
  data-starfield
  data-parallax={parallax ? "on" : "off"}
  aria-hidden="true"
>
  {stars.map((star) => <span class:list={["starfield__star", `starfield__star--${star.tier}`]} />)}
</div>

<style is:inline set:html={starRules}></style>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Overwritten by the parallax stylesheet while the pointer moves. */
    --par-x: 0px;
    --par-y: 0px;
  }

  .starfield__star {
    position: absolute;
    display: block;
    border-radius: 50%;
    will-change: transform;
    transform: translate(calc(var(--par-x) * var(--depth)), calc(var(--par-y) * var(--depth)));
    transition: transform 0.45s var(--ease-soft);
    animation-name: orionTwinkle;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .starfield__star--far {
    width: 1px;
    height: 1px;
    background: var(--color-text-primary);
    box-shadow: 0 0 2px rgba(255, 255, 255, 0.5);
  }

  .starfield__star--mid {
    width: 2px;
    height: 2px;
    background: var(--color-text-primary);
    box-shadow: 0 0 4px rgba(255, 255, 255, 0.5);
  }

  .starfield__star--mid-warm {
    width: 2px;
    height: 2px;
    background: var(--color-accent-light);
    box-shadow: 0 0 4px rgba(249, 189, 119, 0.6);
  }

  .starfield__star--near {
    width: 3px;
    height: 3px;
    background: var(--color-accent-light);
    box-shadow: 0 0 6px rgba(249, 189, 119, 0.6);
  }
</style>

<script>
  const PARALLAX_RANGE = 46;

  const fields = Array.from(
    document.querySelectorAll<HTMLElement>('[data-starfield][data-parallax="on"]'),
  ).filter((field) => field.id);

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (fields.length > 0 && !reduceMotion.matches && "adoptedStyleSheets" in document) {
    // One rule per field, mutated in place — never an inline style attribute.
    const sheet = new CSSStyleSheet();
    sheet.replaceSync(fields.map((field) => `#${field.id}{--par-x:0px;--par-y:0px}`).join(""));
    document.adoptedStyleSheets = [...document.adoptedStyleSheets, sheet];

    const targets = fields.map((field, index) => ({
      field,
      style: (sheet.cssRules[index] as CSSStyleRule).style,
    }));

    let pointer: { x: number; y: number } | null = null;
    let frame = 0;

    const apply = () => {
      frame = 0;
      if (!pointer) return;

      for (const { field, style } of targets) {
        const rect = field.getBoundingClientRect();
        if (!rect.width || !rect.height) continue;

        const cx = (pointer.x - rect.left) / rect.width - 0.5;
        const cy = (pointer.y - rect.top) / rect.height - 0.5;
        style.setProperty("--par-x", `${(-cx * PARALLAX_RANGE).toFixed(1)}px`);
        style.setProperty("--par-y", `${(-cy * PARALLAX_RANGE).toFixed(1)}px`);
      }
    };

    window.addEventListener(
      "mousemove",
      (event) => {
        pointer = { x: event.clientX, y: event.clientY };
        if (!frame) frame = requestAnimationFrame(apply);
      },
      { passive: true },
    );
  }
</script>
