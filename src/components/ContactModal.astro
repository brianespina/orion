---
import { contact, web3forms } from "../data/site";
import IconMail from "./icons/IconMail.astro";
import IconPhone from "./icons/IconPhone.astro";
import IconWeb from "./icons/IconWeb.astro";

const fields = [
  { name: "firstName", label: "First name", type: "text", placeholder: "Jordan", autocomplete: "given-name" },
  { name: "lastName", label: "Last name", type: "text", placeholder: "Reyes", autocomplete: "family-name" },
] as const;

// The prototype used the text glyphs ✉ ☎ ◉. Those fall back to the system
// emoji font on several platforms, so they are drawn as line icons instead.
const details = [
  { Icon: IconMail, label: "Email", value: contact.email, href: `mailto:${contact.email}` },
  {
    Icon: IconPhone,
    label: "Phone",
    value: contact.phone,
    href: `tel:${contact.phone.replace(/\s/g, "")}`,
  },
  { Icon: IconWeb, label: "Web", value: contact.web, href: `https://${contact.web}` },
];
---

<div class="modal" data-contact-modal hidden>
  <div
    class="modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="contact-modal-title"
    data-contact-dialog
  >
    <div class="modal__glow" aria-hidden="true"></div>

    <button class="modal__close" type="button" aria-label="Close" data-contact-close>✕</button>

    <div class="modal__body">
      <div class="modal__info">
        <p class="eyebrow modal__eyebrow">Contact us</p>
        <h2 class="modal__title" id="contact-modal-title">Let's align.</h2>
        <p class="modal__lead">
          Tell us about your brand, and we'll find the partnership that fits. We work with
          international brands and reply by email.
        </p>

        <ul class="modal__details">
          {
            details.map(({ Icon, label, value, href }) => (
              <li class="detail">
                <span class="detail__glyph">
                  <Icon class="icon--sm" />
                </span>
                <span class="detail__text">
                  <span class="detail__label">{label}</span>
                  <a class="detail__value" href={href}>
                    {value}
                  </a>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="modal__panel">
        <form class="contact-form" data-contact-form>
          {/* Web3Forms routes the submission to the inbox behind this key. The
              key is a public identifier — it is meant to ship in the markup. */}
          <input type="hidden" name="access_key" value={web3forms.accessKey} />
          <input type="hidden" name="subject" value={web3forms.subject} />
          <input type="hidden" name="from_name" value={web3forms.fromName} />
          {/* Honeypot: Web3Forms discards any submission that fills this in. */}
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="contact-form__row">
            {
              fields.map((field) => (
                <p class="field">
                  <label class="field__label" for={`contact-${field.name}`}>
                    {field.label}
                  </label>
                  <input
                    class="field__input"
                    id={`contact-${field.name}`}
                    name={field.name}
                    type={field.type}
                    placeholder={field.placeholder}
                    autocomplete={field.autocomplete}
                    required
                  />
                </p>
              ))
            }
          </div>

          <p class="field">
            <label class="field__label" for="contact-email">Work email</label>
            <input
              class="field__input field__input--bright"
              id="contact-email"
              name="email"
              type="email"
              placeholder="you@brand.com"
              autocomplete="email"
              required
            />
          </p>

          <p class="field">
            <label class="field__label" for="contact-company">Company</label>
            <input
              class="field__input"
              id="contact-company"
              name="company"
              type="text"
              placeholder="Your brand"
              autocomplete="organization"
            />
          </p>

          <p class="field field--message">
            <label class="field__label" for="contact-message">Message</label>
            <textarea
              class="field__input field__input--area"
              id="contact-message"
              name="message"
              rows="4"
              placeholder="Tell us about your campaign…"
              required></textarea>
          </p>

          <p class="contact-form__error" role="alert" data-contact-error hidden>
            Something went wrong. Please email us at <a href={`mailto:${contact.email}`}>{contact.email}</a>.
          </p>

          <button class="btn btn-primary btn-block" type="submit" data-contact-submit>
            <span data-submit-label>Send request</span>
          </button>
        </form>

        <div class="success" data-contact-success hidden>
          <span class="success__check" aria-hidden="true">✓</span>
          <h3 class="success__title">Request sent</h3>
          <p class="success__body">Thanks for reaching out. We'll be in touch by email shortly.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    background: var(--color-backdrop);
    backdrop-filter: blur(8px);
    animation: orionFadeIn 0.18s ease both;
  }

  .modal[hidden] {
    display: none;
  }

  .modal__dialog {
    position: relative;
    width: 100%;
    max-width: var(--width-modal);
    max-height: 88vh;
    overflow: auto;
    border: var(--border-modal);
    border-radius: var(--radius-modal);
    background: var(--gradient-modal);
    box-shadow: var(--shadow-modal);
    animation: orionModalIn 0.28s var(--ease-soft) both;
  }

  .modal__glow {
    position: absolute;
    left: 50%;
    top: -120px;
    width: 800px;
    height: 400px;
    max-width: 200vw;
    transform: translateX(-50%);
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(249, 143, 19, 0.18), transparent 70%);
  }

  .modal__close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: var(--border-strong);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-body);
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .modal__close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-text-primary);
  }

  .modal__body {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 52px;
    padding: 56px;
  }

  .modal__eyebrow {
    margin-bottom: 18px;
  }

  .modal__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--font-size-h2-lead);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    margin-bottom: 20px;
  }

  .modal__lead {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--color-text-body);
    max-width: 380px;
    margin-bottom: 36px;
    text-wrap: pretty;
  }

  .modal__details {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .detail__glyph {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: var(--border-accent-soft);
    border-radius: var(--radius-field);
    background: rgba(249, 189, 119, 0.1);
    color: var(--color-accent-light);
  }

  .detail__label {
    display: block;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .detail__value {
    display: block;
    font-size: 15px;
    color: var(--color-text-bright);
    word-break: break-word;
  }

  .detail__value:hover {
    color: var(--color-accent-light);
  }

  /* ---- Form --------------------------------------------------------- */

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    /* Its own fields zero their margin, so the row carries the gap to the
       next field itself — otherwise the name row sits flush against it. */
    margin-bottom: 16px;
  }

  .field {
    margin-bottom: 16px;
  }

  .contact-form__row .field {
    margin-bottom: 0;
  }

  .field--message {
    margin-bottom: 24px;
  }

  .field__label {
    display: block;
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .field__input {
    width: 100%;
    font-size: 14px;
    color: var(--color-text-bright);
    background: rgba(255, 255, 255, 0.03);
    border: var(--border-strong);
    border-radius: var(--radius-field);
    padding: 14px 16px;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .field__input--bright {
    color: var(--color-text-primary);
  }

  .field__input--area {
    display: block;
    resize: vertical;
    min-height: 112px;
  }

  .field__input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-focus-ring);
  }

  .contact-form__error {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-accent-light);
    margin-bottom: 16px;
  }

  .contact-form__error[hidden] {
    display: none;
  }

  /* ---- Success ------------------------------------------------------ */

  .success {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 420px;
    text-align: center;
    border: var(--border-accent);
    border-radius: var(--radius-panel);
    background: rgba(249, 143, 19, 0.05);
    padding: 40px;
  }

  .success[hidden] {
    display: none;
  }

  .success__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--gradient-accent);
    color: var(--color-text-on-accent);
    font-size: 24px;
    margin-bottom: 22px;
  }

  .success__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .success__body {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .modal {
      padding: 16px;
    }

    .modal__dialog {
      max-height: 92vh;
    }

    .modal__body {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 48px 24px 32px;
    }

    .success {
      min-height: 320px;
    }
  }

  @media (max-width: 520px) {
    .contact-form__row {
      grid-template-columns: 1fr;
      gap: 0;
      /* Stacked, the fields space themselves again — the row would double it. */
      margin-bottom: 0;
    }

    .contact-form__row .field {
      margin-bottom: 16px;
    }
  }
</style>

<style is:global>
  /* Disabled submit button while the request is in flight. */
  .btn[disabled] {
    opacity: 0.65;
    cursor: progress;
  }

  .btn[disabled]:hover {
    transform: none;
    box-shadow: none;
  }
</style>

<script>
  const ENDPOINT = "https://api.web3forms.com/submit";
  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  const modal = document.querySelector<HTMLElement>("[data-contact-modal]");
  const dialog = modal?.querySelector<HTMLElement>("[data-contact-dialog]");
  const form = modal?.querySelector<HTMLFormElement>("[data-contact-form]");
  const success = modal?.querySelector<HTMLElement>("[data-contact-success]");
  const errorEl = modal?.querySelector<HTMLElement>("[data-contact-error]");
  const submit = modal?.querySelector<HTMLButtonElement>("[data-contact-submit]");
  const submitLabel = modal?.querySelector<HTMLElement>("[data-submit-label]");

  if (modal && dialog && form && success && errorEl && submit && submitLabel) {
    let lastFocused: HTMLElement | null = null;

    const showOutcome = () => {
      form.hidden = true;
      success.hidden = false;
    };

    const resetForm = () => {
      form.reset();
      form.hidden = false;
      success.hidden = true;
      errorEl.hidden = true;
      submit.disabled = false;
      submitLabel.textContent = "Send request";
    };

    const trapFocus = (event: KeyboardEvent) => {
      const items = Array.from(dialog.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (item) => item.offsetParent !== null,
      );
      if (items.length === 0) return;

      const first = items[0]!;
      const last = items[items.length - 1]!;
      const active = document.activeElement;

      if (event.shiftKey && (active === first || !dialog.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape") close();
      else if (event.key === "Tab") trapFocus(event);
    };

    const open = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      resetForm();
      modal.hidden = false;
      document.body.classList.add("is-modal-open");
      document.addEventListener("keydown", onKeydown);
      dialog.querySelector<HTMLElement>("[data-contact-close]")?.focus();
    };

    const close = () => {
      modal.hidden = true;
      document.body.classList.remove("is-modal-open");
      document.removeEventListener("keydown", onKeydown);
      lastFocused?.focus();
    };

    for (const trigger of document.querySelectorAll("[data-contact-trigger]")) {
      trigger.addEventListener("click", open);
    }

    for (const closer of modal.querySelectorAll("[data-contact-close]")) {
      closer.addEventListener("click", close);
    }

    // Only a click on the backdrop itself closes the dialog.
    modal.addEventListener("click", (event) => {
      if (event.target === modal) close();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      errorEl.hidden = true;
      submit.disabled = true;
      submitLabel.textContent = "Sending…";

      try {
        const response = await fetch(ENDPOINT, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });

        // Web3Forms reports rejections (bad key, spam) in the body, not the status.
        const result = await response.json();
        if (!result.success) throw new Error(result.message ?? `Request failed: ${response.status}`);

        showOutcome();
      } catch (error) {
        console.error(error);
        errorEl.hidden = false;
        submit.disabled = false;
        submitLabel.textContent = "Send request";
      }
    });
  }
</script>
